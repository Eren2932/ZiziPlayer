+@Composable private fun collectionBackground(track: PlayerTrack?, s: DesktopUi, state: LazyListState): Modifier {
+    val cover = coverData(track, s.client)
+    val tone = animatedCollectionTone(if (s.prefs.artworkColor) collectionTone(cover?.primary) else Color(0xFF424242))
+    return Modifier.clipToBounds().drawWithCache {
+        val hero = DesktopLayout.heroHeight(size.width / density).dp.toPx()
+        val end = hero + 244.dp.toPx()
+        val brush = Brush.verticalGradient(
+            0f to tone, (hero / end) to shadeCollectionTone(tone, .62f),
+            ((hero + 1.dp.toPx()) / end) to shadeCollectionTone(tone, .44f),
+            ((hero + 150.dp.toPx()) / end) to shadeCollectionTone(tone, .12f), 1f to Panel,
+            startY = 0f, endY = end)
+        onDrawBehind {
+            drawRect(Panel)
+            // Reads in draw phase: scrolling does not recompose/redecode the page.
+            if (state.firstVisibleItemIndex == 0) translate(top = -state.firstVisibleItemScrollOffset.toFloat()) {
+                drawRect(brush, size = Size(size.width, end))
+            }
+        }
+    }
+}
