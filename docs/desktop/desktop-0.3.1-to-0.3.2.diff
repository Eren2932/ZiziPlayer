+                    }); persist()
+                }
+            }
+        }
+    }
+    private fun dspFor(id: String?): DspConfig = DspCodec.decode(
+        if (prefs.dspGlobal) prefs.globalDsp else id?.let { prefs.trackDsp[it] })
