+
+/** Page header tone, independent of playback and brand controls. White text stays legible. */
+internal fun collectionTone(primary: Int?): Color {
+    if (primary == null) return Color(0xFF424242)
+    val lch = Color(primary).toOklch()
+    return oklch(lch[0].coerceIn(.36f, .50f), lch[1].coerceAtMost(.15f), lch[2])
+}
+@Composable internal fun animatedCollectionTone(target: Color): Color {
+    val progress = remember { Animatable(1f) }
+    var from by remember { mutableStateOf(target) }
+    var to by remember { mutableStateOf(target) }
+    LaunchedEffect(target) {
+        from = blendOklch(from, to, progress.value); to = target; progress.snapTo(0f)
+        progress.animateTo(1f, tween(380, easing = FastOutSlowInEasing))
+    }
+    return blendOklch(from, to, progress.value)
+}
