new file mode 100644
index 0000000..c707cac
--- /dev/null
+++ b/app/src/test/java/app/ziziplayer/ui/SharedCover6104Checks.java
@@ -0,0 +1,58 @@
+package app.ziziplayer.ui;
+
+import app.ziziplayer.ui.theme.ArtworkTopMath;
+
+/** 6.104.0. Production math for the shared-playlist cover: linear fade at fixed size and 2x2 mosaic tint. */
+public final class SharedCover6104Checks {
+    private static int checks;
+    private static void ok(boolean c, String m) { checks++; if (!c) throw new AssertionError(m); }
+    private static double lum(int c) {
+        return .2126 * ((c >> 16) & 255) / 255.0 + .7152 * ((c >> 8) & 255) / 255.0 + .0722 * (c & 255) / 255.0;
+    }
+    private static int hueOf(int c) {
+        float r = ((c >> 16) & 255), g = ((c >> 8) & 255), b = (c & 255);
+        float mx = Math.max(r, Math.max(g, b)), mn = Math.min(r, Math.min(g, b));
+        if (mx == mn) return -1;
+        float d = mx - mn, h;
+        if (mx == r) h = ((g - b) / d) % 6f; else if (mx == g) h = (b - r) / d + 2f; else h = (r - g) / d + 4f;
+        h *= 60f; if (h < 0) h += 360f; return Math.round(h);
+    }
+
+    public static void main(String[] args) {
+        final float span = 610f;
+        ok(CollectionCollapseMath.fixedCoverAlpha(0f, span) == 1f, "rest = fully visible");
+        ok(CollectionCollapseMath.fixedCoverAlpha(-40f, span) == 1f, "overscroll (reveal) never dims the cover");
+        ok(Math.abs(CollectionCollapseMath.fixedCoverAlpha(305f, span) - 0.5f) < 1e-6, "half span = half alpha");
+        ok(CollectionCollapseMath.fixedCoverAlpha(610f, span) == 0f, "gone exactly at the toolbar edge");
+        ok(CollectionCollapseMath.fixedCoverAlpha(5000f, span) == 0f, "stays gone");
+        ok(CollectionCollapseMath.fixedCoverAlpha(Float.NaN, span) == 1f, "NaN scroll is safe");
+        ok(CollectionCollapseMath.fixedCoverAlpha(10f, 0f) == 0f, "degenerate span is safe");
+        float last = 1f;
+        for (int s = 0; s <= 700; s += 5) {
+            float a = CollectionCollapseMath.fixedCoverAlpha(s, span);
+            ok(a <= last + 1e-6f && a >= 0f && a <= 1f, "monotone non-increasing within 0..1");
+            last = a;
+        }
+
+        final int red = 0xff9c1616, blue = 0xff1075ad, grey = 0xff808080, dark = 0xff202020;
+        int one = ArtworkTopMath.mosaicCollectionTop(new int[]{red, red, red, red});
+        ok(Math.abs(hueOf(one) - hueOf(red)) <= 4, "uniform tiles keep their hue");
+        int mixed = ArtworkTopMath.mosaicCollectionTop(new int[]{red, grey, dark, grey});
+        ok(Math.abs(hueOf(mixed) - hueOf(red)) <= 4, "one vivid tile beats grey tiles");
+        int mud = ArtworkTopMath.mosaicCollectionTop(new int[]{red, blue, red, blue});
+        ok(hueOf(mud) >= 0, "opposite hues must not average into grey");
+        int neutral = ArtworkTopMath.mosaicCollectionTop(new int[]{grey, grey, dark, 0xff505050});
+        ok(hueOf(neutral) == -1 || ((neutral >> 16) & 255) == ((neutral >> 8) & 255), "all-grey stays neutral");
+        ok(ArtworkTopMath.mosaicCollectionTop(new int[]{0, 0, 0, 0}) == 0xff292929, "nothing decoded yet = default tint");
+        ok(ArtworkTopMath.mosaicCollectionTop(null) == 0xff292929, "null is safe");
+        ok(ArtworkTopMath.mosaicCollectionTop(new int[]{red, 0, 0, 0}) != 0xff292929, "partial decode already tints");
+        // Top row borders the backdrop gradient: it decides a 2-vs-2 split.
+        int topBlue = ArtworkTopMath.mosaicCollectionTop(new int[]{blue, blue, red, red});
+        int topRed = ArtworkTopMath.mosaicCollectionTop(new int[]{red, red, blue, blue});
+        ok(Math.abs(hueOf(topBlue) - hueOf(blue)) <= 6 && Math.abs(hueOf(topRed) - hueOf(red)) <= 6, "top row wins a 2-2 split");
+        for (int[] tiles : new int[][]{{red, blue, grey, dark}, {blue, blue, blue, blue}, {0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff}, {0xffffff00, 0xff00ffff, 0xffff00ff, 0xff00ff00}}) {
+            ok(lum(ArtworkTopMath.mosaicCollectionTop(tiles)) <= 0.40, "header tint stays dark enough for white text");
+        }
+        System.out.println("SharedCover6104Checks OK: " + checks + " assertions");
+    }
+}
