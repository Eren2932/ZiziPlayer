index f4b2efe..b677b58 100644
--- a/app/src/main/java/app/ziziplayer/ui/theme/ArtworkTopMath.java
+++ b/app/src/main/java/app/ziziplayer/ui/theme/ArtworkTopMath.java
@@ -192,6 +192,97 @@ public final class ArtworkTopMath {
         return pack(hsvToRgb(h, s, lo));
     }
 
+    /**
+     * 6.104.0: Calibrated header tint for a 2x2 mosaic cover (up to 4 quadrant top colours).
+     * Top-row quadrants (indices 0, 1) border the upper backdrop gradient and receive higher
+     * spatial weight; vivid quadrants outvote monochrome/grey tiles so B&W covers in a 2x2 grid
+     * do not wash out a colourful neighbour; angular clustering prevents opposite hues from
+     * cancelling into grey mud. Always bounded by {@link #COLLECTION_LUMINANCE_CEILING}.
+     */
+    public static int mosaicCollectionTop(int[] tops) {
+        if (tops == null || tops.length == 0) return 0xff292929;
+        final int count = Math.min(tops.length, 4);
+        final double[] hues = new double[count];
+        final double[] sats = new double[count];
+        final double[] vals = new double[count];
+        final double[] weights = new double[count];
+        double totalChromatic = 0.0;
+        for (int i = 0; i < count; i++) {
+            final int c = tops[i];
+            if (c == 0) continue;
+            final double r = ((c >> 16) & 0xff) / 255.0;
+            final double g = ((c >> 8) & 0xff) / 255.0;
+            final double b = (c & 0xff) / 255.0;
+            final double mx = Math.max(r, Math.max(g, b));
+            final double mn = Math.min(r, Math.min(g, b));
+            final double d = mx - mn;
+            final double s = mx > 0 ? d / mx : 0.0;
+            double h = 0.0;
+            if (d > 0) {
+                if (mx == r) h = ((g - b) / d) % 6.0;
+                else if (mx == g) h = (b - r) / d + 2.0;
+                else h = (r - g) / d + 4.0;
+                h *= 60.0;
+                if (h < 0) h += 360.0;
+            }
+            hues[i] = h;
+            sats[i] = s;
+            vals[i] = mx;
+            final double spatial = (i < 2) ? 1.35 : 1.0;
+            final double chroma = s >= 0.08 && mx >= 0.12
+                ? Math.pow(s, 1.35) * (0.25 + 0.75 * mx)
+                : 0.0;
+            weights[i] = spatial * chroma;
+            totalChromatic += weights[i];
+        }
+        if (totalChromatic <= 1e-6) {
+            double vSum = 0.0;
+            int valid = 0;
+            for (int i = 0; i < count; i++) {
+                if (tops[i] != 0) { vSum += vals[i]; valid++; }
+            }
+            if (valid == 0) return 0xff292929;
+            final double v = Math.max(FLOOR / 255.0, Math.min(0.28, vSum / valid * 0.55));
+            return collectionTop(pack(hsvToRgb(0.0, 0.0, v)));
+        }
+        int anchor = 0;
+        double bestCluster = -1.0;
+        for (int i = 0; i < count; i++) {
+            if (weights[i] <= 0) continue;
+            double score = 0.0;
+            for (int j = 0; j < count; j++) {
+                if (weights[j] <= 0) continue;
+                final double diff = hueDistance(hues[i], hues[j]);
+                if (diff <= 75.0) {
+                    score += weights[j] * Math.cos(Math.toRadians(diff));
+                }
+            }
+            if (score > bestCluster) {
+                bestCluster = score;
+                anchor = i;
+            }
+        }
+        double sx = 0.0, sy = 0.0, ss = 0.0, sv = 0.0, sw = 0.0;
+        for (int j = 0; j < count; j++) {
+            if (weights[j] <= 0) continue;
+            final double diff = hueDistance(hues[anchor], hues[j]);
+            if (diff > 75.0) continue;
+            final double w = weights[j] * Math.max(0.15, Math.cos(Math.toRadians(diff)));
+            final double rad = Math.toRadians(hues[j]);
+            sx += w * Math.sin(rad);
+            sy += w * Math.cos(rad);
+            ss += w * sats[j];
+            sv += w * vals[j];
+            sw += w;
+        }
+        if (sw <= 1e-9) return collectionTop(tops[anchor]);
+        double h = Math.toDegrees(Math.atan2(sx, sy));
+        if (h < 0) h += 360.0;
+        final double s = Math.min(1.0, ss / sw);
+        final double v = Math.max(V_LOW, Math.min(V_HIGH, sv / sw));
+        return collectionTop(capLightness(hsvToRgb(h, s, v)));
+    }
+
