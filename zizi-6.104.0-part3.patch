@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""6.104.0. Общие плейлисты: падение «+», компактные окна, новые треки сверху, меню, обложка/поиск/сортировка."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SRC = ROOT / 'app/src/main/java/app/ziziplayer'
+
+
+def read(rel):
+    return (SRC / rel).read_text(encoding='utf-8')
+
+
+class Shared6104(unittest.TestCase):
+    def test_plus_does_not_crash_on_local_artwork(self):
+        picker = read('ui/screens/SharedLibraryPicker.kt')
+        self.assertNotIn('RemoteArtwork(', picker)  # content:// у локальных файлов не должен попадать в OkHttp
+        self.assertIn('TrackArtwork(entry.track', picker)
+        http = read('data/remote/ZiziHttp.kt')
+        fetch = http.split('fun fetchBytes(', 1)[1].split('\n    }\n', 1)[0]
+        self.assertLess(fetch.index('startsWith("http://"'), fetch.index('Request.Builder()'))
+        self.assertLess(fetch.index('return try {'), fetch.index('.url(url)'))  # url() внутри try
+        self.assertIn('catch (e: IllegalArgumentException)', fetch)
+        art = read('ui/components/Artwork.kt')
+        self.assertIn('private fun validNetworkUrl(', art)
+        for fn in ('fun peekUrl(', 'suspend fun loadUrl(', 'private suspend fun fetchUrl('):
+            self.assertIn('validNetworkUrl(url)', art.split(fn, 1)[1].split('\n', 3)[1] + art.split(fn, 1)[1].split('\n', 3)[2], fn)
+
+    def test_sheets_hug_content(self):
+        layout = read('ui/screens/SharedSheetLayout.kt')
+        self.assertNotIn('fillMaxHeight(', layout)
+        self.assertIn('weight(1f, fill = false)', layout)
+        self.assertIn('heightIn(max = maxSheetHeight)', layout)
+
+    def test_new_tracks_land_on_top_for_everyone(self):
+        repo = read('shared/SharedRepository.kt')
+        self.assertIn('SharedKeys.prependSequence(view.firstOrNull()?.pos, accepted.size)', repo)
+        self.assertNotIn('SharedKeys.sequence(view.lastOrNull()?.pos, accepted.size)', repo)
+        keys = read('shared/SharedKeys.kt')
+        self.assertIn('fun prependSequence(first: String?, count: Int): List<String>', keys)
+        self.assertIn('out.reverse()', keys)  # порядок внутри пачки = порядок выбора
+
+    def test_track_menu_is_full_zizi_menu_plus_shared_actions(self):
+        screens = read('ui/screens/SharedScreens.kt')
+        self.assertIn('SearchTrackActionsHost(remote = menuRemote', screens)
+        for action in ('shared-play', 'shared-by', 'shared-top', 'shared-up', 'shared-down', 'shared-bottom', 'shared-remove'):
+            self.assertIn('"' + action + '"', screens)
+        host = read('ui/screens/SearchTrackActionsHost.kt')
+        self.assertIn('if (!action.local && prepared == null)', host)  # «Убрать/Выше» не пишут трек в медиатеку
