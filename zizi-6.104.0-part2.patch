+/** 6.104.0. Вид плейлиста: источник, запрос, сортировка и фильтр «мои» привязаны к результату, чтобы очередь и строки не расходились. */
+private data class SharedView(
+    val query: String, val sort: CollectionViewSort, val mine: Boolean,
+    val source: List<SharedTrack>, val rows: List<Pair<Int, SharedTrack>>
+)
+
+/**
+ * 6.104.0. Цвет шапки по обложке. Одна обложка — её собственный tint, как у всех коллекций.
+ * Мозаика 2x2 (>= 4 обложек) — взвешенный по четырём плиткам ArtworkTopMath.mosaicCollectionTop:
+ * верхний ряд весит больше (он граничит с градиентом), цветные плитки перевешивают серые,
+ * противоположные оттенки не смешиваются в грязно-серый. Плитки берутся из того же кэша, что и сама обложка.
+ */
+@Composable
+private fun rememberSharedTint(arts: List<String>): Color {
+    val px = if (arts.size >= 4) SHARED_TILE_PX else SHARED_COVER_PX
+    val a0 = rememberUrlArtwork(arts.getOrNull(0), px)
+    val a1 = rememberUrlArtwork(arts.getOrNull(1), px)
+    val a2 = rememberUrlArtwork(arts.getOrNull(2), px)
+    val a3 = rememberUrlArtwork(arts.getOrNull(3), px)
+    val target = remember(arts.size, a0, a1, a2, a3) {
+        when {
+            arts.size >= 4 -> {
+                val tops = listOf(a0, a1, a2, a3).map { it?.swatches?.top?.toArgb() ?: 0 }.toIntArray()
+                if (tops.all { it == 0 }) Color(0xFF292929) else Color(ArtworkTopMath.mosaicCollectionTop(tops))
+            }
+            arts.isEmpty() -> Color(0xFF292929)
+            else -> a0?.swatches?.collectionTint ?: Color(0xFF292929)
+        }
+    }
+    val tint by animateColorAsState(target, tween(COLLECTION_COVER_FADE_MS), label = "shared-tint")
+    return tint
+}
+
+private const val SHARED_COVER_PX = 640
+private const val SHARED_TILE_PX = 384
